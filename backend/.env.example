# ==========================================
# BeyondFear Backend Configuration
# ==========================================
# Copy this file to .env.local and fill in YOUR keys
# NEVER commit .env or .env.local to git

# ==========================================
# DATABASE
# ==========================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/beyondfear-dev
# Get free MongoDB: https://www.mongodb.com/cloud/atlas

# ==========================================
# AI - GEMINI (Google) - FREE TIER
# ==========================================
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-1.5-flash
# Get FREE API key: https://aistudio.google.com/app/apikey
# Free tier: 15 RPM, 1M tokens/day — sufficient for MVP

# ==========================================
# PAYMENTS - RAZORPAY (India)
# ==========================================
# Test Mode (No real money charged)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=rzp_test_xxxxxxxxxxxxxxxx
# Sign up for free test account: https://razorpay.com/sign-up
# Test card: 4111 1111 1111 1111 (any future expiry)

# ==========================================
# PAYMENTS - STRIPE (Global Alternative)
# ==========================================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get free test keys: https://dashboard.stripe.com/test/apikeys

# Choose ONE payment provider (Razorpay for India, Stripe for global)
PAYMENT_PROVIDER=razorpay
# Options: "razorpay" or "stripe"

# ==========================================
# SERVER
# ==========================================
PORT=5000
NODE_ENV=development
# Options: "development" | "production"

# ==========================================
# SECURITY - JWT
# ==========================================
JWT_SECRET=generate-your-own-random-secret-minimum-32-characters-long
JWT_EXPIRE=7d
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_URL=http://localhost:5173
# When deployed: https://yourfrontend.vercel.app

# ==========================================
# EMAIL (Optional for notifications)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ==========================================
# OPTIONAL: Vector DB (Post-MVP)
# ==========================================
# PINECONE_API_KEY=xxxxxxxxxxxxxxxxxxxx
# PINECONE_INDEX=beyondfear-sessions
