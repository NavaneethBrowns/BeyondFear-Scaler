# ==========================================
# BeyondFear Frontend Configuration
# ==========================================
# Copy this file to .env.local and fill in YOUR keys
# NEVER commit .env or .env.local to git

# ==========================================
# PAYMENTS - RAZORPAY
# ==========================================
# Use TEST mode key (no real money charged)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# Get free test account: https://razorpay.com/sign-up

# ==========================================
# API SERVER
# ==========================================
VITE_API_URL=http://localhost:5000/api
# Note: Backend auth middleware validates JWT tokens from localStorage
